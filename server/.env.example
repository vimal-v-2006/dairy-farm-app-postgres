# Server Environment Variables

# REQUIRED: PostgreSQL connection string from Neon
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dairyfarm?sslmode=require

# REQUIRED: JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-key-at-least-32-chars

# OPTIONAL: Port (Render sets this automatically)
PORT=4000

# OPTIONAL: Frontend URL for CORS (your Vercel app URL)
FRONTEND_URL=http://localhost:5173

# OPTIONAL: Upload directory (Render free tier is ephemeral!)
UPLOADS_DIR=./uploads

# OPTIONAL: Set to "production" in deployed environments
NODE_ENV=development
